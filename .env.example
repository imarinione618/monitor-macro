# ---------------------------------------------------------------
# Copiar a .env y completar. NUNCA commitear .env.
# ---------------------------------------------------------------

# --- INDEC (Catálogo API-INDEC) ---
# JWT generado en https://api.indec.gob.ar/ (perfil -> generar token). Solo se muestra una vez.
INDEC_API_TOKEN=
# Opcionales
INDEC_API_BASE_URL=https://api.indec.gob.ar/v1
INDEC_TIMEOUT_MS=30000
INDEC_MAX_RETRIES=4
# Pausa mínima entre requests (ms), para no saturar la API
INDEC_MIN_INTERVAL_MS=250
# Vigencia de la caché de respuestas crudas (horas). 0 = sin caché.
INDEC_CACHE_TTL_HOURS=6

# --- Almacenamiento local ---
# Directorio del store normalizado (por defecto ./data/store)
STORE_DIR=
# "real" (default) o "fixtures" (datos SINTÉTICOS para desarrollo; la UI muestra un aviso)
DATA_MODE=real

# --- Google Sheets ---
# Método: "oauth" (recomendado, documentos propiedad del usuario) o "service_account"
GOOGLE_AUTH_MODE=oauth
# OAuth de escritorio (cliente "Desktop app" creado en Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Ruta donde se guarda el refresh token tras `npm run sheets:auth` (gitignored)
GOOGLE_OAUTH_TOKEN_PATH=.secrets/google-oauth-token.json
# Cuenta de servicio (alternativa): ruta al JSON de la clave
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Para service_account: IDs de documentos creados por el usuario y compartidos como Editor
SHEETS_ID_ACTIVIDAD=
SHEETS_ID_LABORAL=
SHEETS_ID_PRECIOS=
SHEETS_ID_COMEX=

# --- Programación ---
# Hora local de Buenos Aires para la actualización diaria (HH:MM)
REFRESH_DAILY_TIME=08:30
